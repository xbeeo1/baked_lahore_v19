<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_analytic_distribution_permission"
            model="ir.ui.view">

        <field name="name">
            res.users.form.analytic.distribution.permission
        </field>

        <field name="model">res.users</field>

        <field name="inherit_id" ref="base.view_users_form"/>

        <field name="arch" type="xml">

            <xpath expr="//page[@name='access_rights']"
                   position="inside">

                <group string="Analytic Accounting">
                    <field name="allow_edit_analytic_distribution"/>
                    <field name="analytic_account_ids" widget="many2many_tags" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}"/>
                </group>

            </xpath>

        </field>
    </record>

</odoo>
