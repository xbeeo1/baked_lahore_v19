<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="purchase_order_line_analytic_distribution_permission"
            model="ir.ui.view">

            <field name="name">
                purchase.order.line.analytic.distribution.permission
            </field>

            <field name="model">purchase.order</field>

            <field name="inherit_id" ref="purchase.purchase_order_form"/>

            <field name="arch" type="xml">

                <xpath expr="//field[@name='order_line']/list"
                       position="inside">

                    <field name="allow_edit_analytic_distribution"
                           column_invisible="True"/>

                </xpath>

                <xpath expr="//field[@name='order_line']/list/field[@name='analytic_distribution']"
                       position="attributes">

                    <attribute name="readonly">
                        not allow_edit_analytic_distribution
                    </attribute>

                </xpath>

            </field>
        </record>



    </data>

</odoo>