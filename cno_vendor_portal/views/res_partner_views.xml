<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_inherit_portal" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.portal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@class='oe_button_box']" position="after">
                <div class="text-end mb-2">
                    <button name="action_create_portal_user"
                            type="object"
                            string="Create Portal User"
                            class="btn btn-primary"
                            icon="fa-user"/>
                </div>
            </xpath>

        </field>
    </record>




</odoo>