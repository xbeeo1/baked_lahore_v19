<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_profit_classification_list" model="ir.ui.view">
            <field name="name">profit.classification.list</field>
            <field name="model">profit.classification</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_profit_classification_form" model="ir.ui.view">
            <field name="name">profit.classification.form</field>
            <field name="model">profit.classification</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <field name="name"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_profit_classification" model="ir.actions.act_window">
            <field name="name">Profit Classification</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">profit.classification</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Profit Classification...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_profit_classification"
                  name="Profit Classification"
                  parent="stock.menu_product_in_config_stock"
                  action="action_profit_classification"
                  sequence="6"/>

    </data>
</odoo>
