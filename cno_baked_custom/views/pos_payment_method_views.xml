<?xml version="1.0"?>
<odoo>
    <data>
        <record id="pos_payment_method_view_form_inherit_custom" model="ir.ui.view">
            <field name="name">pos.payment.method.view.form.inherit.custom</field>
            <field name="model">pos.payment.method</field>
            <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_method_type']" position="after">
                   <group string="Account Information" >
                        <field name="expense_account_id" />
                        <field name="bank_account_id" />
                       <field name="charges_per" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
