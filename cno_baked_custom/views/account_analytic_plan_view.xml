<odoo>
    <record id="view_account_analytic_plan_form_inherit" model="ir.ui.view">
        <field name="name">account.analytic.plan.form.inherit.is_pos_plan</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_applicability']" position="after">
                <field name="is_pos_plan"/>
            </xpath>
        </field>
    </record>
</odoo>