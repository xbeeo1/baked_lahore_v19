<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_accounting_head_list" model="ir.ui.view">
            <field name="name">accounting.head.list</field>
            <field name="model">accounting.head</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_accounting_head_form" model="ir.ui.view">
            <field name="name">accounting.head.form</field>
            <field name="model">accounting.head</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <field name="name"/>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="accounting_head_line">
                                    <list string="Lines" editable="bottom">
                                        <field name="account_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_accounting_head" model="ir.actions.act_window">
            <field name="name">Accounting Head</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">accounting.head</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Accounting Head...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_accounting_head"
                  name="Accounting Head"
                  parent="cno_baked_custom.menu_menu_configuration"
                  action="action_accounting_head"
                  sequence="5"/>

    </data>
</odoo>
