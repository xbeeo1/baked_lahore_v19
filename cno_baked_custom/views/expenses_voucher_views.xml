<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_expenses_voucher_list" model="ir.ui.view">
            <field name="name">expenses.voucher.list</field>
            <field name="model">expenses.voucher</field>
            <field name="arch" type="xml">
                <list>
                    <field name="voucher_no" />
                    <field name="date"/>
                    <field name="mop_id"/>
                    <field name="payee_id"/>
                    <field name="total_amount" sum="Total"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_expenses_voucher_form" model="ir.ui.view">
            <field name="name">expenses.voucher.form</field>
            <field name="model">expenses.voucher</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_cancel" type="object" string="Cancel" class="oe_highlight" invisible="state != 'confirm'"/>
                        <button name="action_reset_to_draft" type="object" string="Reset To Draft" class="oe_highlight" invisible="state != 'cancel'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_entry" type="object" class="oe_stat_button"
                                    icon="fa-pencil-square-o" invisible="entry_total == 0">
                                <field name="entry_total" widget="statinfo" string="Journal Entry"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="voucher_no" />
                                <field name="mop_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" />
<!--                                <field name="cost_centre_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" readonly="state != 'draft'"/>-->
<!--                                <field name="brand_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" readonly="state != 'draft'"/>-->
                            </group>
                            <group>
                                <field name="date" readonly="state != 'draft'"/>
<!--                                <field name="revenue_stream_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" readonly="state != 'draft'"/>-->
                                <field name="payee_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="expenses_voucher_line" readonly="state != 'draft'">
                                    <list string="Lines" editable="bottom" >
                                        <field name="accounting_head_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}"/>
                                        <field name="account_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}"/>
                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                        <field name="description"/>
                                        <field name="amount" sum="Total"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_expenses_voucher_search" model="ir.ui.view">
            <field name="name">expenses.voucher.search</field>
            <field name="model">expenses.voucher</field>
            <field name="arch" type="xml">
                <search string="Search Portal">
                    <field name="voucher_no"/>
                    <field name="expense_nature_id"/>
                    <field name="mop_id"/>
                    <group>
                        <filter string="Expense Nature" name="expense_nature_id" context="{'group_by':'expense_nature_id'}"/>
                        <filter string="MOP" name="mop_id" context="{'group_by':'mop_id'}"/>
                        <filter string="Date" name="date" context="{'group_by':'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_expenses_voucher" model="ir.actions.act_window">
            <field name="name">Expenses Voucher</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">expenses.voucher</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Expenses Voucher...!
                </p>
            </field>
        </record>

        <menuitem id="main_menu_expenses_voucher"
                  name="Expense Voucher"
                  sequence="9"
                  web_icon="cno_baked_custom,static/description/exp2.png"
        />

        <menuitem id="menu_action_expenses_voucher"
                  name="Expense Voucher"
                  parent="main_menu_expenses_voucher"
                  action="action_expenses_voucher"
                  sequence="1"/>

        <menuitem id="menu_menu_configuration"
                  name="Configuration"
                  parent="main_menu_expenses_voucher"
                  groups="cno_baked_custom.group_expenses_voucher_conf_menu_access"
                  sequence="10"/>


    </data>
</odoo>
