<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_cogs_basis_list" model="ir.ui.view">
            <field name="name">cogs.basis.list</field>
            <field name="model">cogs.basis</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_cogs_basis_form" model="ir.ui.view">
            <field name="name">cogs.basis.form</field>
            <field name="model">cogs.basis</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <field name="name"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cogs_basis" model="ir.actions.act_window">
            <field name="name">COGS Basis</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cogs.basis</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First COGS Basis...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_cogs_basis"
                  name="COGS Basis"
                  parent="stock.menu_product_in_config_stock"
                  action="action_cogs_basis"
                  sequence="5"/>

    </data>
</odoo>
