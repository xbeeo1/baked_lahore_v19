<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_ledger_wizard_form" model="ir.ui.view">
        <field name="name">purchase.ledger.wizard.form</field>
        <field name="model">purchase.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Base Ledger">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="report_type" widget="radio"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                        <field name="account_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Print"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Purchase Base Ledger</field>
        <field name="res_model">purchase.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item under Accounting > Reporting -->
    <menuitem id="menu_purchase_ledger_wizard"
              name="Purchase Base Ledger"
              parent="account.account_reports_partners_reports_menu"
              action="action_purchase_ledger_wizard"
              sequence="11"/>

</odoo>
